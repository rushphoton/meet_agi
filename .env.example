# Recall.ai API key (dashboard > API Keys) - meeting bot provider
RECALL_API_KEY=
# Recall.ai region your account lives in
RECALL_REGION=us-west-2
# Google AI Studio key for Gemini (aistudio.google.com/apikey)
GEMINI_API_KEY=
# Anthropic Console API key (platform.claude.com)
ANTHROPIC_API_KEY=
# Inworld API key, Base64 "Basic" credential (platform.inworld.ai)
INWORLD_API_KEY=
# Inworld TTS voice ID to speak with
INWORLD_VOICE_ID=
# Public HTTPS base URL for webhooks (ngrok static domain)
PUBLIC_BASE_URL=
# Shared secret Recall must send on webhooks (random, not a vendor key)
RECALL_WEBHOOK_TOKEN=
# Frontend -> backend base URL
NEXT_PUBLIC_API_BASE=http://localhost:8000
# Which LLM to use: gemini | anthropic
LLM_PROVIDER=gemini
# Which TTS voice provider to use
VOICE_PROVIDER=inworld
# Meeting-bot vendor: attendee (Recall rejected Gmail signup) | recall
BOT_PROVIDER=attendee
# Attendee API key (app.attendee.dev > API Keys)
ATTENDEE_API_KEY=
# Attendee hosted API base URL
ATTENDEE_BASE_URL=https://app.attendee.dev
# Recall workspace verification secret (whsec_...), dashboard > API keys; optional until milestone 4
RECALL_WORKSPACE_SECRET=
# 1 = enable developer endpoints (fake meeting). scripts/serve.py turns this on.
DEV_MODE=
# 1 = never call a vendor; use canned providers only
OFFLINE=
